<+>package org.firstinspires.ftc.teamcode.subsystems;\n\nimport com.bylazar.configurables.annotations.Configurable;\nimport com.qualcomm.robotcore.hardware.DcMotor;\nimport com.qualcomm.robotcore.hardware.DcMotorEx;\nimport com.qualcomm.robotcore.hardware.HardwareMap;\nimport com.qualcomm.robotcore.hardware.VoltageSensor;\nimport com.qualcomm.robotcore.util.ElapsedTime;\n\n@Configurable\npublic class Shooter {\n    public static double SHOOT_RPM = 2000.0;\n    public static double AT_SPEED_TOLERANCE_RPM = 50.0;\n\n\n    public static double KF = 0.00025;\n\n    public static double KP = 0.005;\n\n    public static double BOOST_THRESHOLD_RPM = 200.0;\n\n    public static double RPM_FILTER_ALPHA = 0.4;\n\n\n    public static double TICKS_PER_REV = 28.0;\n\n    public static double MOTOR_TO_WHEEL_RATIO =\n            1.0;\n\n    // =========================================================\n    // POWER LIMIT\n    // =========================================================\n\n    public static double MAX_POWER = 1.0;\n\n    // =========================================================\n    // VOLTAGE COMPENSATION\n    // =========================================================\n\n    public static double NOMINAL_VOLTAGE = 13.0;\n\n    public static double MIN_COMPENSATION_VOLTAGE = 11.0;\n    public static double VOLTAGE_READ_INTERVAL_S = 0.25;\n\n    // =========================================================\n    // MOTOR\n    // =========================================================\n\n    private final HardwareMap hardwareMap;\n\n    private final DcMotorEx shooterMotor;\n\n    // =========================================================\n    // MODE\n    // =========================================================\n\n    public enum Mode {\n        OFF,\n        SHOOTING\n    }\n\n    private Mode mode = Mode.OFF;\n\n    // =========================================================\n    // CACHED VALUES\n    // =========================================================\n\n    private final ElapsedTime voltageTimer =\n            new ElapsedTime();\n\n    private double batteryVoltage =\n            NOMINAL_VOLTAGE;\n\n    private double voltageCompensation =\n            1.0;\n\n    private double currentRPM =\n            0.0;\n\n    private double targetRPM =\n            0.0;\n\n    private double errorRPM =\n            0.0;\n\n    private double commandedPower =\n            0.0;\n\n    // =========================================================\n    // CONSTRUCTOR\n    // =========================================================\n\n    public Shooter(HardwareMap hardwareMap) {\n\n        this.hardwareMap = hardwareMap;\n\n        shooterMotor = hardwareMap.get(\n                DcMotorEx.class,\n                \"shooterMotor\"\n        );\n\n        shooterMotor.setDirection(\n                DcMotor.Direction.FORWARD\n        );\n\n        shooterMotor.setZeroPowerBehavior(\n                DcMotor.ZeroPowerBehavior.FLOAT\n        );\n\n        shooterMotor.setMode(\n                DcMotor.RunMode.RUN_WITHOUT_ENCODER\n        );\n\n        refreshVoltage();\n\n        shooterOff();\n    }\n\n    // =========================================================\n    // UPDATE\n    // =========================================================\n\n    public void update() {\n\n        if (voltageTimer.seconds()\n                >= VOLTAGE_READ_INTERVAL_S) {\n\n            refreshVoltage();\n        }\n\n        updateRPM();\n\n        if (mode == Mode.OFF) {\n\n            targetRPM = 0.0;\n            errorRPM = 0.0;\n            commandedPower = 0.0;\n\n            shooterMotor.setPower(0.0);\n\n            return;\n        }\n\n        targetRPM = SHOOT_RPM;\n\n        errorRPM =\n                targetRPM - currentRPM;\n\n        commandedPower =\n                calculatePower(\n                        targetRPM,\n                        currentRPM\n                );\n\n        shooterMotor.setPower(\n                commandedPower\n        );\n    }\n\n    private double calculatePower(\n            double targetRPM,\n            double measuredRPM\n    ) {\n\n        if (targetRPM <= 0.0) {\n            return 0.0;\n        }\n\n        double error =\n                targetRPM - measuredRPM;\n\n        if (error > BOOST_THRESHOLD_RPM) {\n            return clip(\n                    MAX_POWER,\n                    MAX_POWER\n            );\n        }\n\n        double power =\n                targetRPM * KF * voltageCompensation\n                        + error * KP;\n\n        return clip(\n                power,\n                MAX_POWER\n        );\n    }\n    private void refreshVoltage() {\n\n        batteryVoltage =\n                readBatteryVoltage();\n\n        voltageCompensation =\n                NOMINAL_VOLTAGE\n                        / Math.max(\n                        MIN_COMPENSATION_VOLTAGE,\n                        batteryVoltage\n                );\n\n        voltageTimer.reset();\n    }\n\n    private double readBatteryVoltage() {\n\n        double highestVoltage = 0.0;\n\n        for (VoltageSensor sensor\n                : hardwareMap.voltageSensor) {\n\n            double voltage =\n                    sensor.getVoltage();\n\n            if (voltage > 0.0\n                    && Double.isFinite(voltage)) {\n\n                highestVoltage =\n                        Math.max(\n                                highestVoltage,\n                                voltage\n                        );\n            }\n        }\n\n        return highestVoltage > 0.0\n                ? highestVoltage\n                : NOMINAL_VOLTAGE;\n    }\n\n    private void updateRPM() {\n\n        double raw = readRawRPM();\n\n        double alpha =\n                Math.max(\n                        0.0,\n                        Math.min(\n                                1.0,\n                                RPM_FILTER_ALPHA\n                        )\n                );\n\n        currentRPM =\n                alpha * raw\n                        + (1.0 - alpha) * currentRPM;\n    }\n\n    private double readRawRPM() {\n\n        if (TICKS_PER_REV <= 0.0\n                || MOTOR_TO_WHEEL_RATIO <= 0.0) {\n\n            return 0.0;\n        }\n\n        double ticksPerSecond =\n                Math.abs(\n                        shooterMotor.getVelocity()\n                );\n\n        double motorRPM =\n                ticksPerSecond\n                        * 60.0\n                        / TICKS_PER_REV;\n\n        return motorRPM\n                * MOTOR_TO_WHEEL_RATIO;\n    }\n\n\n    public void shooterOn() {\n        mode = Mode.SHOOTING;\n    }\n\n    public void shooterOff() {\n\n        mode = Mode.OFF;\n\n        targetRPM = 0.0;\n        errorRPM = 0.0;\n        commandedPower = 0.0;\n\n        shooterMotor.setPower(0.0);\n    }\n\n\n    public Mode getMode() {\n        return mode;\n    }\n\n    public String getModeName() {\n        return mode.name();\n    }\n\n    public boolean isShooting() {\n        return mode == Mode.SHOOTING;\n    }\n\n    public boolean isOff() {\n        return mode == Mode.OFF;\n    }\n\n    public boolean isAtSpeed() {\n        return mode == Mode.SHOOTING\n                && Math.abs(errorRPM)\n                <= AT_SPEED_TOLERANCE_RPM;\n    }\n\n    public double getRPM() {\n        return currentRPM;\n    }\n\n    public double getTargetRPM() {\n        return targetRPM;\n    }\n\n    public double getErrorRPM() {\n        return errorRPM;\n    }\n\n    public double getCommandedPower() {\n        return commandedPower;\n    }\n\n    public double getBatteryVoltage() {\n        return batteryVoltage;\n    }\n\n    public double getVoltageCompensation() {\n        return voltageCompensation;\n    }\n\n\n    private double clip(\n            double power,\n            double maximumPower\n    ) {\n\n        double max =\n                Math.max(\n                        0.0,\n                        Math.min(\n                                1.0,\n                                maximumPower\n                        )\n                );\n\n        return Math.max(\n                0.0,\n                Math.min(\n                        max,\n                        power\n                )\n        );\n    }\n}
